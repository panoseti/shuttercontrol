(version 1)
# JLCPCB rigid PCB capabilities, standard process, 4 layers, 1 oz outer / 0.5 oz inner copper.
# Source: https://jlcpcb.com/capabilities/Capabilities (read 2026-11-02).
# Board-level minimums (Board Setup > Constraints, in shuttercontrol.kicad_pro):
#   min clearance 0.1, min track 0.1, min via 0.45/0.2, min hole-to-hole 0.2, copper to edge 0.3.
# Netclass Default: track 0.2, clearance 0.2, via 0.6/0.3.

# --- Drilling ---
# Drill 0.15-6.3 mm; via hole < 0.2 mm or via diameter < 0.45 mm costs extra, so vias are kept at >= 0.45/0.2.
(rule "JLC hole size"
	(constraint hole_size (min 0.15mm) (max 6.3mm)))

(rule "JLC via size"
	(condition "A.Type == 'Via'")
	(constraint via_diameter (min 0.45mm))
	(constraint hole_size (min 0.2mm)))

# Multilayer PTH annular ring: absolute minimum 0.15 mm (0.20 mm recommended).
# Applies to component holes only; for vias JLCPCB only asks diameter >= hole + 0.1 mm (0.05 mm ring),
# which the 0.45/0.2 via minimum already exceeds.
(rule "JLC PTH annular ring"
	(condition "A.Pad_Type == 'Through-hole'")
	(constraint annular_width (min 0.15mm)))

# Via hole-to-hole 0.2 mm (board minimum); pad hole-to-hole 0.45 mm.
(rule "JLC pad hole to hole"
	(condition "A.Type == 'Pad' && B.Type == 'Pad'")
	(constraint hole_to_hole (min 0.45mm)))

# --- Hole to copper ---
# Via hole to track 0.2 mm, NPTH to track 0.2 mm.
(rule "JLC hole to copper"
	(constraint hole_clearance (min 0.2mm)))

# PTH to track: minimum 0.28 mm (0.35 mm recommended).
(rule "JLC PTH hole to copper"
	(condition "A.Pad_Type == 'Through-hole'")
	(constraint hole_clearance (min 0.28mm)))

# Inner layers: PTH pad hole to copper 0.3 mm.
(rule "JLC inner PTH hole to copper"
	(layer inner)
	(condition "A.Pad_Type == 'Through-hole'")
	(constraint hole_clearance (min 0.3mm)))

# --- Copper spacing ---
# SMD pad to pad (different nets) 0.15 mm; overrides the 0.2 mm netclass clearance for fine-pitch parts.
(rule "JLC SMD pad to pad"
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'SMD' && B.Pad_Type == 'SMD'")
	(constraint clearance (min 0.15mm)))

# Copper to routed board edge >= 0.2 mm; 0.3 mm used for margin.
(rule "JLC copper to edge"
	(constraint edge_clearance (min 0.3mm)))

# --- Legend (silkscreen) ---
# Line width >= 0.15 mm, text height >= 1.0 mm, pad to silkscreen >= 0.15 mm.
(rule "JLC silkscreen text"
	(layer "?.Silkscreen")
	(condition "A.Type == 'Text' || A.Type == 'Field'")
	(constraint text_height (min 1.0mm))
	(constraint text_thickness (min 0.15mm)))

(rule "JLC silkscreen clearance"
	(layer "?.Silkscreen")
	(constraint silk_clearance (min 0.15mm)))
